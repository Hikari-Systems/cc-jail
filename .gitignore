# Claude Code state (credentials, history, settings) -- but keep the directory
# itself, so the bind mount has something to attach to on a fresh clone.
.claude/*
!.claude/.gitkeep

# Container-side CLI config: your git identity, gh's token. Same reasoning --
# and never commit it, it is personal and (for gh) a live credential.
# .config/git/ is kept as well, so seeding an identity is a plain redirect
# into an existing directory rather than a mkdir the README has to explain.
.config/*
!.config/.gitkeep
!.config/git/
.config/git/*
!.config/git/.gitkeep

# Cloud CLI logins for the container: `aws configure` writes .aws/credentials
# and .aws/config, `az login` writes .azure/. Mounted so a login outlives the
# container, ignored because both hold live credentials -- .aws/credentials is
# a long-lived access key in plain text and .azure/ caches refresh tokens.
.aws/*
!.aws/.gitkeep

.azure/*
!.azure/.gitkeep

# Pulumi's state: the access token from `pulumi login` in credentials.json,
# plus the downloaded provider plugins. Mounted so neither has to be fetched
# again next run; ignored because of the token, and because plugins/ runs to
# hundreds of MB and is a cache, not source.
.pulumi/*
!.pulumi/.gitkeep

# ssh config and known_hosts for the container. Same reasoning again -- and
# nothing in here should ever reach a remote.
.ssh/*
!.ssh/.gitkeep

# Default workspace mount; same reasoning.
cc-jail/*
!cc-jail/.gitkeep

.env

# Superseded: Claude Code now keeps this inside .claude/ via CLAUDE_CONFIG_DIR.
# Still ignored so a leftover copy from an older checkout can't be committed.
/.claude.json
