# Copy to .env and edit:  cp .env.example .env
#
# Host directory to mount into the container. This is the only part of your
# filesystem Claude can see.
WORKSPACE_HOST=~/workspace

# Where it appears inside the container.
WORKSPACE_PATH=/workspace

# Ownership of files the container writes back to the host (Linux).
# Match your host user:  id -u  /  id -g
UID=1000
GID=1000

# GID of the group owning /var/run/docker.sock on the host, so the container
# can use the mounted socket without sudo. Read it off the socket itself --
# do not assume, it varies by platform (999 on plain Ubuntu/Debian, commonly
# 1001 under Docker Desktop / WSL2, 0 on macOS):
#
#   stat -c '%g' /var/run/docker.sock
#
# Appending it to an existing .env, leaving the other keys alone:
#
#   echo "DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)" >> .env
#
# Compose feeds this to the build (to name the group) and to group_add (which
# is what actually grants access at run time), so a wrong value here is fixed
# by `docker compose up` -- no rebuild needed.
DOCKER_GID=999

# ── Memory (the `memory` profile) ────────────────────────────────────────────
#
# None of this is needed for a plain `docker compose run --rm claude`, and none of
# it is read unless you start the memory stack. See "Memory" in README.md.
#
# The LLM that extracts entities is Claude via AWS Bedrock, so there is no
# Anthropic API key here -- the calls are signed as AWS requests. A task or
# instance role needs only AWS_REGION; locally, set the access keys too. The
# account must be able to invoke the model id in memory/mcp/config.yaml.
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=

# The embedder is Voyage. Changing embedder changes the vector dimension, which
# means rebuilding the graph -- see README.md.
#VOYAGE_API_KEY=

# Host-side ports for the memory stack, both bound to 127.0.0.1 and both moved off
# the conventional default (7687 for Bolt, 8000 for the MCP server) so they do not
# collide with anything else on this machine. The jail reaches both services over
# the compose network instead, so these matter only for reaching them from the host.
#SLATER_BOLT_PORT=7688
#GRAPHITI_PORT=8010

# Slater's password. Must be the plaintext whose argon2id hash is in
# memory/acl/acl.json, which ships a working -- and published -- pair, so leave
# this unset to use it. memory/acl/README.md says how to mint your own.
#SLATER_PASSWORD=graphiti-example

# Leave unset to use the released Slater image the compose file pins. Set it only
# to run Slater built from source.
#SLATER_IMAGE=
