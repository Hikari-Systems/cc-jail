# Copy to .env and edit:  cp .env.example .env
#
# Host directory to mount into the container. This is the only part of your
# filesystem Claude can see.
WORKSPACE_HOST=~/workspace

# Where it appears inside the container.
WORKSPACE_PATH=/workspace

# Ownership of files the container writes back to the host (Linux).
# Match your host user:  id -u  /  id -g
UID=1000
GID=1000

# GID of the group owning /var/run/docker.sock on the host, so the container
# can use the mounted socket without sudo. Read it off the socket itself --
# do not assume, it varies by platform (999 on plain Ubuntu/Debian, commonly
# 1001 under Docker Desktop / WSL2, 0 on macOS):
#
#   stat -c '%g' /var/run/docker.sock
#
# Appending it to an existing .env, leaving the other keys alone:
#
#   echo "DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)" >> .env
#
# Compose feeds this to the build (to name the group) and to group_add (which
# is what actually grants access at run time), so a wrong value here is fixed
# by `docker compose up` -- no rebuild needed.
DOCKER_GID=999
